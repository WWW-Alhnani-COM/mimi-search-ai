# Supabase project settings (public client values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Never expose SUPABASE_SERVICE_ROLE_KEY in browser code.
# Never commit Telegram API credentials or MTProto session strings.
# Telegram MTProto connector (server/worker only; never NEXT_PUBLIC_)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 32-byte base64 key for encrypting Telegram session credentials before persistence.
TELEGRAM_SESSION_ENCRYPTION_KEY=
